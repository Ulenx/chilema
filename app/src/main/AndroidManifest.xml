<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        声明「我们要用相机拍照」，Android 11 起不写的话
        resolveActivity 查相机应用一律返回 null。用 ACTION_IMAGE_CAPTURE
        本身不需要 CAMERA 权限（拍的是相机应用，不是我们），所以别去申请它 ——
        一旦声明了 CAMERA，反而变成必须运行时授权才能拍。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".MenuApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Menu">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Menu">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                从别的 App「分享」文字或链接进来。
                必须单独一个 intent-filter：MAIN/LAUNCHER 那组不能混进 SEND，
                而且在别的组里声明过的 DEFAULT 分类不算数，这里得再写一遍。
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
            拍照用的临时文件中转：相机应用往这里写，我们再读回来压进私有目录。
            exported=false + grantUriPermissions：只有被我们显式授权的那个相机
            应用能写这一个文件，别的谁也进不来。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
